XLLC    =     1.750
YLLC    =     1.750

;-----------------------------------------------------------------------
PLTYPE =    line
lintyp= 8 : lindot=0 : linsiz=0.8 : pltlwt=0.5
b=13 : c=5 : d=0.41
c2=100*d*log(2)/log(c) ; dB/oct
xdata=$1/1000
ydata=b*[c^(-$3/100)]*[$x^(1-d)]
zdata=0
  ; y = a + b * c**(-i/100.) * f**(-d)
  ; a =  0.  , b =   13.0000  , c =   5.00000  , d =  0.410000
  ; f1 =  0.200000  , f2 =   8.00000   kHz
   200.000    18.227    20
  8000.000     4.017    20
  plot
   200.000    15.518    30
  8000.000     3.420    30
  plot
   200.000    13.211    40
  8000.000     2.911    40
  plot
   200.000    11.247    50
